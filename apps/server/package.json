{
  "name": "server",
  "version": "0.0.1",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "pnpm --filter @code-trainer/db generate && tsc --noEmit && esbuild src/index.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist/index.js --external:@prisma/client --external:prisma --external:fastify-openapi-glue",
    "start": "node dist/index.js",
    "test": "node --env-file=../../.env node_modules/vitest/vitest.mjs run",

    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@code-trainer/content-schema": "workspace:*",
    "@prisma/client": "^7.10.0",
    "@code-trainer/db": "workspace:*",
    "@code-trainer/learning-engine": "workspace:*",
    "@code-trainer/telemetry-contract": "workspace:*",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "acorn": "^8.19.0",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.5",
    "fastify-openapi-glue": "^4.11.5",
    "js-yaml": "^5.4.3",
    "quickjs-emscripten": "^0.32.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "ajv": "^8.0.0",
    "ajv-formats": "^3.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
