{
  "name": "server",
  "version": "0.0.1",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist/index.js --external:@prisma/client --external:prisma --external:fastify-openapi-glue",
    "start": "node dist/index.js",
    "test": "node --env-file=../../.env node_modules/vitest/vitest.mjs run",

    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@code-trainer/content-schema": "workspace:*",
    "@prisma/client": "^5.0.0",
    "@code-trainer/db": "workspace:*",
    "@code-trainer/learning-engine": "workspace:*",
    "@code-trainer/telemetry-contract": "workspace:*",
    "@fastify/cookie": "^9.0.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/swagger": "^8.0.0",
    "@fastify/swagger-ui": "^3.0.0",
    "acorn": "^8.15.0",
    "bcryptjs": "^2.4.3",
    "fastify": "^4.0.0",
    "fastify-openapi-glue": "^4.0.0",
    "js-yaml": "^4.0.0",
    "quickjs-emscripten": "^0.32.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.0.0",
    "@types/bcryptjs": "^2.4.0",
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.25.0",
    "ajv": "^8.0.0",
    "ajv-formats": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
