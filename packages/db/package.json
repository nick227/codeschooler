{
  "name": "@code-trainer/db",
  "version": "0.0.1",
  "main": "./src/client.ts",
  "types": "./src/client.ts",
  "scripts": {
    "generate": "prisma generate --schema=prisma/schema.prisma",
    "build": "prisma generate --schema=prisma/schema.prisma",
    "db:push": "node --env-file=../../.env node_modules/prisma/build/index.js db push",
    "db:seed": "tsx --env-file=../../.env prisma/seed.ts",
    "db:studio": "node --env-file=../../.env node_modules/prisma/build/index.js studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.2.0",
    "prisma": "^7.9.1",
    "tsx": "^4.0.0",
    "typescript": "^7.0.2"
  }
}
